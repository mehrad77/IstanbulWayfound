    "@tailwindcss/vite": "4.3.3",
    "@wayfound/core": "workspace:*",
    "@wayfound/i18n": "workspace:*",
    "@wayfound/schema": "workspace:*",
    "@wayfound/ui": "workspace:*",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
