---
import { PILLARS, type Pillar } from "@wayfound/core";
import Base from "../../layouts/Base.astro";
import AuditStartForm from "../../components/AuditStartForm.astro";
import FaqList from "../../components/FaqList.astro";
import { home, homeFaqs, models } from "../../lib/copy.ts";
import { localePaths, PUBLIC_ORIGIN, type SiteLocale } from "../../lib/env.ts";
import { faqNode } from "../../lib/faq-schema.ts";
import { industries } from "../../lib/industries.ts";
import { services } from "../../lib/services.ts";

export const getStaticPaths = localePaths;
const lang = Astro.params.lang as SiteLocale;
const site = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const demoCards = [
  { name: "Café Lale", what: lang === "tr" ? "QR menü · Şişli" : "QR menu · Şişli", href: `${PUBLIC_ORIGIN}/m/cafe-lale?lang=${lang}` },
  { name: "Selvi Textile Showroom", what: lang === "tr" ? "Toptan katalog · Osmanbey" : "Wholesale catalog · Osmanbey", href: `${PUBLIC_ORIGIN}/m/selvi-showroom?lang=${lang}` },
  { name: "Defne Dental Clinic", what: lang === "tr" ? "İmplant paketi · Şişli" : "Implant package · Şişli", href: `${PUBLIC_ORIGIN}/c/defne-dental/implants-6-day?lang=${lang}` },
];
---
<Base lang={lang} title={home.title[lang]} description={home.description[lang]} path="/" jsonLd={[faqNode(homeFaqs, lang, `${site}/${lang}/`)!]}>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 pt-14 pb-10 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="eyebrow">{home.eyebrow[lang]}</p>
      <h1 class="mt-3 font-serif text-4xl leading-tight font-semibold text-cobalt-900 sm:text-5xl">{home.hero[lang]}</h1>
      <p class="mt-5 max-w-xl text-lg text-ink-soft">{home.heroLead[lang]}</p>
      <p class="mt-6 flex flex-wrap gap-2 text-sm text-ink-soft">
        {["ChatGPT", "Perplexity", "Gemini", "Google AI Overviews", "Google Maps", "Apple Maps", "Yandex"].map((e) => <span class="rounded-full border border-line bg-white px-3 py-1">{e}</span>)}
      </p>
    </div>
    <div id="audit">
      <h2 class="mb-3 font-semibold text-ink">{home.auditCta[lang]}</h2>
      <AuditStartForm lang={lang} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="verticals">
    <h2 id="verticals" class="font-serif text-3xl font-semibold text-cobalt-900">{home.verticalsTitle[lang]}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {industries.map((i) => (
        <a href={`/${lang}/industries/${i.slug}/`} class="card block p-6 hover:border-cobalt-300">
          <h3 class="font-serif text-xl font-semibold text-ink">{i.title[lang]}</h3>
          <p class="mt-2 text-sm text-ink-soft">{i.lead[lang]}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-cobalt-700">{lang === "tr" ? "Devamı" : "Read more"} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-cobalt-900 py-16 text-white" aria-labelledby="pillars">
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="pillars" class="font-serif text-3xl font-semibold">{home.pillarsTitle[lang]}</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-5">
        {services.map((s) => (
          <li>
            <a href={`/${lang}/services/${s.slug}/`} class="block h-full rounded-2xl border border-white/15 bg-white/5 p-5 hover:bg-white/10">
              <span class="font-serif text-3xl text-terracotta-300">{s.pillar}</span>
              <h3 class="mt-2 font-semibold">{PILLARS[s.pillar as Pillar].name[lang]}</h3>
              <p class="mt-2 text-sm text-white/70">{s.lead[lang]}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="models">
    <h2 id="models" class="font-serif text-3xl font-semibold text-cobalt-900">{home.modelsTitle[lang]}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {models.map((m) => (
        <div class="card p-6">
          <h3 class="font-serif text-2xl font-semibold text-ink">{m.name[lang]}</h3>
          <p class="mt-1 text-ink-soft">{m.lead[lang]}</p>
          <ul class="mt-4 grid gap-2 text-sm">{m.items.map((it) => <li class="flex gap-2"><span class="text-ok">✓</span>{it[lang]}</li>)}</ul>
          <p class="mt-4 text-xs text-ink-soft">{m.note[lang]}</p>
          <p class="mt-4 text-sm font-semibold text-ink">{lang === "tr" ? "Fiyat: bize ulaşın" : "Pricing: contact us"}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm"><a class="font-semibold text-cobalt-700" href={`/${lang}/how-we-work/`}>{lang === "tr" ? "İki modeli yan yana karşılaştırın" : "Compare the two side by side"} →</a></p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="demos">
    <h2 id="demos" class="font-serif text-3xl font-semibold text-cobalt-900">{home.demosTitle[lang]}</h2>
    <p class="mt-2 max-w-2xl text-ink-soft">{home.demosLead[lang]}</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {demoCards.map((d) => (
        <a href={d.href} class="card block p-6 hover:border-terracotta-300">
          <span class="rounded bg-warn-soft px-1.5 py-0.5 text-xs font-semibold text-warn">Demo</span>
          <h3 class="mt-3 font-semibold text-ink">{d.name}</h3>
          <p class="text-sm text-ink-soft">{d.what}</p>
          <span class="mt-3 inline-block text-sm font-semibold text-terracotta-600">{lang === "tr" ? "Telefonda açın" : "Open it"} ↗</span>
        </a>
      ))}
    </div>
  </section>

  <FaqList faqs={homeFaqs} lang={lang} title={home.faqTitle[lang]} />
</Base>
