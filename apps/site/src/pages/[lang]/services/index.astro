---
import Base from "../../../layouts/Base.astro";
import { nav } from "../../../lib/copy.ts";
import { localePaths, type SiteLocale } from "../../../lib/env.ts";
import { MODE_LABEL, services } from "../../../lib/services.ts";

export const getStaticPaths = localePaths;
const lang = Astro.params.lang as SiteLocale;
const title = nav.services[lang];
---
<Base lang={lang} title={title} description={lang === "tr" ? "Beş hizmet alanı: GEO, haritalar, çok dilli akışlar, görsel prodüksiyon ve itibar." : "Five service pillars: GEO, maps, multilingual funnels, visual production and reputation."} path="/services/" crumbs={[{ name: title, path: "/services/" }]}>
  <section class="mx-auto max-w-5xl px-4 pt-14">
    <h1 class="font-serif text-4xl font-semibold text-cobalt-900">{title}</h1>
    <div class="mt-8 grid gap-4">
      {services.map((s) => (
        <a href={`/${lang}/services/${s.slug}/`} class="card grid gap-2 p-6 hover:border-cobalt-300 md:grid-cols-[60px_1fr]">
          <span class="font-serif text-4xl text-terracotta-500">{s.pillar}</span>
          <span>
            <span class="block font-serif text-2xl font-semibold text-ink">{s.title[lang]}</span>
            <span class="mt-1 block text-ink-soft">{s.lead[lang]}</span>
            <span class="mt-3 flex flex-wrap gap-1.5">
              {[...new Set(s.modules.map((m) => m.mode))].map((m) => <span class="rounded-md bg-paper-deep px-2 py-0.5 text-xs font-medium text-ink-soft">{MODE_LABEL[m][lang]}</span>)}
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>
