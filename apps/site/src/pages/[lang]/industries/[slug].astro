---
import { PROMPT_TEMPLATES } from "@wayfound/core";
import Base from "../../../layouts/Base.astro";
import FaqList from "../../../components/FaqList.astro";
import AuditStartForm from "../../../components/AuditStartForm.astro";
import { nav } from "../../../lib/copy.ts";
import { LOCALES, PUBLIC_ORIGIN, type SiteLocale } from "../../../lib/env.ts";
import { faqNode } from "../../../lib/faq-schema.ts";
import { industries } from "../../../lib/industries.ts";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => industries.map((i) => ({ params: { lang, slug: i.slug } })));
}
const lang = Astro.params.lang as SiteLocale;
const page = industries.find((i) => i.slug === Astro.params.slug)!;
const site = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const district = page.vertical === "retail" ? "Osmanbey" : "Şişli";
const prompts = PROMPT_TEMPLATES[page.vertical].slice(0, 5).map((p) => p.text[lang].replaceAll("{district}", district));
---
<Base lang={lang} title={page.title[lang]} description={page.lead[lang]} path={`/industries/${page.slug}/`} jsonLd={[faqNode(page.faqs, lang, `${site}/${lang}/industries/${page.slug}/`)!]} crumbs={[{ name: nav.industries[lang], path: "/industries/" }, { name: page.title[lang], path: `/industries/${page.slug}/` }]}>
  <section class="mx-auto max-w-5xl px-4 pt-14">
    <p class="eyebrow">{nav.industries[lang]}</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold text-cobalt-900">{page.title[lang]}</h1>
    <p class="mt-4 max-w-3xl text-xl text-ink">{page.lead[lang]}</p>
  </section>
  <section class="mx-auto mt-10 grid max-w-5xl gap-6 px-4 md:grid-cols-2">
    <div class="card p-6">
      <h2 class="font-semibold text-ink">{lang === "tr" ? "Tanıdık gelecek sorunlar" : "What gets in the way"}</h2>
      <ul class="mt-3 grid gap-2 text-sm text-ink-soft">{page.pains.map((p) => <li class="flex gap-2"><span class="text-terracotta-500">•</span>{p[lang]}</li>)}</ul>
    </div>
    <div class="card p-6">
      <h2 class="font-semibold text-ink">{lang === "tr" ? "Turistlerin yapay zekâya sorduğu sorular" : "What tourists ask AI"}</h2>
      <ul class="mt-3 grid gap-2 text-sm">{prompts.map((p) => <li class="rounded-lg bg-paper-deep px-3 py-2 text-ink">“{p}”</li>)}</ul>
    </div>
  </section>
  <section class="mx-auto mt-10 max-w-5xl px-4">
    <div class="card p-6">
      <p class="text-xs font-semibold text-warn">{lang === "tr" ? "DEMO İŞLETME" : "DEMO BUSINESS"}</p>
      <h2 class="mt-1 font-serif text-2xl font-semibold text-ink">{page.demoName}</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {page.demoLinks.map((d) => <a class="btn-secondary py-2 text-sm" href={`${PUBLIC_ORIGIN}${d.path}?lang=${lang}`}>{d.label[lang]} ↗</a>)}
      </div>
    </div>
  </section>
  <div class="mt-14"><FaqList faqs={page.faqs} lang={lang} title={lang === "tr" ? "Sorular" : "Questions"} /></div>
  <section class="mx-auto mt-14 max-w-2xl px-4"><AuditStartForm lang={lang} /></section>
</Base>
