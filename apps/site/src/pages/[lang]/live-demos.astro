---
import Base from "../../layouts/Base.astro";
import { demos } from "../../lib/copy.ts";
import { CONSOLE_ORIGIN, localePaths, PUBLIC_ORIGIN, type SiteLocale } from "../../lib/env.ts";
import { industries } from "../../lib/industries.ts";

export const getStaticPaths = localePaths;
const lang = Astro.params.lang as SiteLocale;
---
<Base lang={lang} title={demos.title[lang]} description={demos.lead[lang]} path="/live-demos/" crumbs={[{ name: demos.title[lang], path: "/live-demos/" }]}>
  <section class="mx-auto max-w-5xl px-4 pt-14">
    <h1 class="font-serif text-4xl font-semibold text-cobalt-900">{demos.title[lang]}</h1>
    <p class="mt-4 max-w-3xl text-lg text-ink-soft">{demos.lead[lang]}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {industries.map((i) => (
        <div class="card p-6" data-demo={i.demoSlug}>
          <p class="text-xs font-semibold text-terracotta-600">{i.title[lang]}</p>
          <h2 class="mt-1 font-serif text-xl font-semibold text-ink">{i.demoName}</h2>
          <ul class="mt-4 grid gap-2 text-sm">
            {i.demoLinks.map((d) => <li><a class="font-semibold text-cobalt-700" href={`${PUBLIC_ORIGIN}${d.path}?lang=${lang}`}>{d.label[lang]} ↗</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <a class="card block p-6 hover:border-cobalt-300" href={`/${lang}/audit/`}>
        <h2 class="font-semibold text-ink">{lang === "tr" ? "Yapay Zekâ Görünürlük Denetimi" : "AI Visibility Audit"}</h2>
        <p class="mt-1 text-sm text-ink-soft">{lang === "tr" ? "\"Café Lale\" yazarak tohumlanmış demo raporunu görün." : "Type \"Café Lale\" to see the seeded demo report."}</p>
      </a>
      <a class="card block p-6 hover:border-cobalt-300" href={`${CONSOLE_ORIGIN}/login`}>
        <h2 class="font-semibold text-ink">{demos.console[lang]}</h2>
        <p class="mt-1 text-sm text-ink-soft">{lang === "tr" ? "Menüyü düzenleyin, fiyatı değiştirin, telefonda anında görün." : "Edit the menu, change a price, see it on the phone straight away."}</p>
      </a>
    </div>
  </section>
</Base>
