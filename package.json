{
  "name": "wayfound",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --filter \"./apps/*\" run build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "pnpm --filter @wayfound/db generate",
    "db:migrate": "pnpm --filter @wayfound/api db:migrate",
    "demo:reset": "node scripts/demo-reset.mjs",
    "deploy": "pnpm --filter @wayfound/api run deploy && pnpm --filter @wayfound/public run deploy && pnpm --filter @wayfound/console run deploy && pnpm --filter @wayfound/site run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
